# Copy to .env (never commit it). All keys are optional; each one unlocks a module.
YOUTUBE_API_KEY=            # YouTube Data API v3 key (discovery + stats)
TWITCH_CLIENT_ID=           # dev.twitch.tv app (discovery of live streams + clips)
TWITCH_CLIENT_SECRET=
ANTHROPIC_API_KEY=          # news -> sourced script writer (falls back to a template without it)
# YouTube upload (OAuth "installed app" refresh token with youtube.upload scope)
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=
